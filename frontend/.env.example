# Frontend always calls the same-origin API path.
# On Vercel, frontend/vercel.json rewrites /api/* to the hosted backend.
VITE_API_BASE_URL=/api

# Local dev proxy target used by vite.config.ts.
# Use http://localhost:8080 when running the backend locally.
VITE_API_PROXY_TARGET=http://163.176.244.21:8080
